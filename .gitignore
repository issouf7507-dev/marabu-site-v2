# Originaux du shooting (6000x4000, ~60 Mo) : ils ne sont jamais servis, seuls
# les WebP générés dans public/persons/ le sont. Les archiver hors dépôt et
# les remettre ici pour rejouer scripts/build-portraits.py.
/src/assets/persons/

# Specs (documents de travail, dont des .docx binaires)
/specs/

# Sources des CV (.pptx, ~1,6 Mo) : jamais servies, leur contenu est transcrit
# dans src/config/cv.ts. Les archiver hors dépôt et les remettre ici pour
# reprendre la transcription lors d'une mise à jour.
/src/assets/*.pptx
